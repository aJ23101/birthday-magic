# Supabase Credentials (optional for local preview, required for live database sync across devices)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only credentials for authenticated email sends and event logging.
# Never prefix these values with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL="BirthdayMagic <birthday@your-verified-domain.com>"

# Public App URL (Used for absolute shareable links & WhatsApp shares)
NEXT_PUBLIC_APP_URL=http://localhost:3000
